# Copier ce fichier en .env et renseigner les valeurs.
# cp .env.example .env

# OpenAI (obligatoire pour le RAG — branches rag-core et suivantes)
OPENAI_API_KEY=sk-...

# Qdrant (base vectorielle locale ou cloud)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chantiers_archeo

# Modèles (optionnel — valeurs par défaut dans rag/config.py)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# LLM_PROMPT_NAME=structured_citations

# RAG avancé (optionnel)
# ENABLE_QUERY_REWRITE=true
# ENABLE_RERANK=true

# Chemin PDF (optionnel — défaut : data/pdfs/liste_chantiers_latest.pdf)
# PDF_PATH=data/pdfs/liste_chantiers_latest.pdf
